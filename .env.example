# Turnright Database MCP Server 配置模板
# 复制为 mcp-config.env 或作为环境变量使用。
#
# 仅支持多数据源格式。单数据源写法（DATABASE_URL / MONGODB_URI 等）已移除。
# 两种使用方式：
#   1) 文件：保存为 mcp-config.env（由程序读取并自动映射成 Spring 属性）
#   2) OS 环境变量（Docker -e / export）：需使用完整属性名，见下方注释示例

# MCP 传输（优先级：System property > 环境变量 > 本文件 > 默认值）
MCP_TRANSPORT=stdio
MCP_PORT=8080
# 管理口令（HTTP 模式 http://host:port/admin 的写操作需要；未设置则只读+可测连接）
# MCP_ADMIN_TOKEN=change-me

# ============================================
# MySQL（可选）—— 单数据源时命名成 default
# ============================================
MYSQL_ENABLED=false
# DATABASE_DATASOURCES_0_NAME=default
# DATABASE_DATASOURCES_0_URL=jdbc:mysql://localhost:3306/mydb
# DATABASE_DATASOURCES_0_USERNAME=root
# DATABASE_DATASOURCES_0_PASSWORD=password
# DATABASE_DATASOURCES_0_DESCRIPTION=MySQL业务数据库
# DATABASE_DATASOURCES_0_READONLY=true
# 多源：再加 DATABASE_DATASOURCES_1_NAME/URL/USERNAME/...，并用 MYSQL_DEFAULT_DATASOURCE 指定默认

# ============================================
# SQL Server（可选）
# ============================================
SQLSERVER_ENABLED=false
# SQLSERVER_DATASOURCES_0_NAME=default
# SQLSERVER_DATASOURCES_0_URL=jdbc:sqlserver://localhost:1433;databaseName=mydb;encrypt=false
# SQLSERVER_DATASOURCES_0_USERNAME=sa
# SQLSERVER_DATASOURCES_0_PASSWORD=password
# SQLSERVER_DATASOURCES_0_DESCRIPTION=SQL Server数据库
# SQLSERVER_DATASOURCES_0_READONLY=true

# ============================================
# MongoDB（可选）
# ============================================
MONGODB_ENABLED=false
# MONGODB_DATASOURCES_0_NAME=default
# MONGODB_DATASOURCES_0_URI=mongodb://localhost:27017
# MONGODB_DATASOURCES_0_DATABASE=mydb
# MONGODB_DATASOURCES_0_DESCRIPTION=MongoDB文档数据库
# MONGODB_DATASOURCES_0_READONLY=true

# ============================================
# Elasticsearch（可选）
# ============================================
ES_ENABLED=false
# ES_DATASOURCES_0_NAME=default
# ES_DATASOURCES_0_HOST=localhost
# ES_DATASOURCES_0_PORT=9200
# ES_DATASOURCES_0_USERNAME=elastic
# ES_DATASOURCES_0_PASSWORD=password
# ES_DATASOURCES_0_SSL=false
# ES_DATASOURCES_0_DESCRIPTION=Elasticsearch搜索引擎
# ES_DATASOURCES_0_READONLY=true

# ============================================
# Oracle（可选）
# ============================================
ORACLE_ENABLED=false
# ORACLE_DATASOURCES_0_NAME=default
# ORACLE_DATASOURCES_0_URL=jdbc:oracle:thin:@localhost:1521:ORCL
# ORACLE_DATASOURCES_0_USERNAME=system
# ORACLE_DATASOURCES_0_PASSWORD=password
# ORACLE_DATASOURCES_0_DESCRIPTION=Oracle数据库
# ORACLE_DATASOURCES_0_READONLY=true

# ============================================
# Redis（可选）
# ============================================
REDIS_ENABLED=false
# REDIS_DATASOURCES_0_NAME=default
# REDIS_DATASOURCES_0_HOST=localhost
# REDIS_DATASOURCES_0_PORT=6379
# REDIS_DATASOURCES_0_PASSWORD=
# REDIS_DATASOURCES_0_DESCRIPTION=Redis缓存服务器
# REDIS_DATASOURCES_0_READONLY=true

# ============================================
# 安全模式（readOnly）说明
# ============================================
# readOnly=true（默认）: 只允许查询（SELECT, find, search）
# readOnly=false: 允许写入（INSERT, UPDATE, DELETE, index, create）
# 生产环境建议保持 readOnly=true，防止 AI 工具意外修改数据

# ============================================
# OS 环境变量方式（Docker -e / export）注意
# ============================================
# 不使用 mcp-config.env 时，环境变量需用"完整属性名"的宽松绑定形式：
#   数据库类型前缀 + 数据源索引 + 字段
#   MySQL:     DATABASE_MYSQL_DATASOURCES_0_URL=...        （属性 database.mysql.datasources[0].url）
#   SQLServer: DATABASE_SQLSERVER_DATASOURCES_0_URL=...
#   MongoDB:   DATABASE_MONGODB_DATASOURCES_0_URI=...
#   ES:        DATABASE_ELASTICSEARCH_DATASOURCES_0_HOST=...
#   Oracle:    DATABASE_ORACLE_DATASOURCES_0_URL=...
#   Redis:     DATABASE_REDIS_DATASOURCES_0_HOST=...
# 启用标志同理：MYSQL_ENABLED 在 OS env 下对应 DATABASE_MYSQL_ENABLED=true
